# Set secrets in Vercel Environment Variables, never in Git.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=fast-investment-bos-one.vercel.app
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REFERENCE
DB_PASSWORD=replace-with-your-database-password
DB_HOST=YOUR_SUPABASE_POOLER_HOST
DB_PORT=6543
REDIS_URL=rediss://USERNAME:PASSWORD@YOUR_REDIS_HOST:PORT/0
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_HTTP_ONLY=True
AUTH_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=https://fast-investment-bos-one.vercel.app
CSRF_TRUSTED_ORIGINS=https://fast-investment-bos-one.vercel.app
